- task_key = "digest"
- enabled = current_unit.settings(:communication).digest == "true"
- icon_class = t("settings.icons.#{task_key}")
- icon_color = t("settings.icon_colors.#{task_key}")

article#digest_settings.py-4.switch-toggle-container.border.border-stone-400.rounded.p-4
  h2.font-bold.text-xl.mb-2
    i(class="fa-solid fa-fw mr-1 #{icon_class} #{icon_color}")
    = t("settings.titles.#{task_key}")

  p.text-md.text-stone-600.dark:text-stone-400.mb-3
    = t("settings.descriptions.#{task_key}")

  = switch("settings[communication]", task_key, { label: t("settings.labels.digest"), checked: enabled, container: "article" }, "true", "false")

  .config.mt-4
    = label_tag :digest_day_of_week, t("settings.labels.digest_day_of_week"), class: "block font-bold mb-1"

    .flex.flex-row.gap-2.items-center
      = weekday_select "settings[communication]", "digest_day_of_week", { selected: current_unit.settings(:communication).digest_day_of_week.capitalize }, class: "text-stone-800 w-full rounded border-paper-400"
      = " at "
      = select_hour(current_unit.settings(:communication).digest_hour_of_day.to_i,
                    { prefix: "settings[communication]",
                      field_name: "digest_hour_of_day",
                      leading_zeros: false,
                      use_two_digit_numbers: false,
                      ampm: true },
                    class: "w-full rounded text-stone-800 border-stone-400")

    .mt-4
      = f.label :digest_note, t("settings.labels.digest_note"), class: "block font-bold mb-1"
      p.text-sm.text-stone-600.dark:text-stone-400.mb-2 = t("settings.descriptions.digest_note")
      = f.rich_text_area :digest_note,
                         class: "bg-white text-stone-800 w-full border border-stone-400 rounded overflow-auto min-h-32"

      label.flex.items-center.gap-2.mt-2.text-sm
        = hidden_field_tag "settings[communication][digest_note_keep]", "false", id: nil
        = check_box_tag "settings[communication][digest_note_keep]", "true", current_unit.keep_digest_note?
        = t("settings.labels.digest_note_keep")

    .flex.flex-col.md:flex-row.gap-2.mt-4
      = link_to t("settings.buttons.digest_preview"), unit_digest_preview_path(current_unit),
                target: "_blank", rel: "noopener", data: { turbo: false },
                class: "rounded font-semibold border border-stone-400 px-4 py-2 text-center hover:bg-stone-100 dark:hover:bg-stone-800"
      = button_tag t("settings.buttons.digest_test_send"),
                   type: "submit",
                   form: "digest_test_send_form",
                   class: "rounded font-semibold border border-stone-400 px-4 py-2 hover:bg-stone-100 dark:hover:bg-stone-800"

/ See build_options in https://github.com/rails/rails/blob/049c95161d32092663376b0b14d1a454fd43aa01/actionview/lib/action_view/helpers/date_helper.rb#L1194

css:
  #digest_settings .config {
    display: none;
  }

  #digest_settings.switch-on .config {
    display: block;
  }