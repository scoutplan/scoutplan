<%= turbo_frame_tag :main, data: { controller: "event-filter" } do %>
  <%= content_for :header_title do %>
    <h1 class="md:text-3xl font-semibold font-serif">
      Upcoming
      <span class="block font-sans text-sm text-paper-700">
        <%= @start_date.strftime("%B %Y") %> to <%= @end_date.strftime("%B %Y") %>
      </span>
    </h1>
  <% end %>

  <%= content_for :header_extra do %>
    <%= render partial: "events/list/event_category_filters" %>
  <% end # content_for :header_extra %>

  <%= render "header" %>

  <section id="event_months" class="">
    <%= render "blank_slate" %>

    <ol id="events_list">
      <% presenter = @presenter || EventPresenter.new %>
      <% @events_by_month.each do |month, events| %>
        <%= render partial: "events/list/event_month", locals: { month: month, events: events, presenter: presenter } %>
      <% end %>
    </ol>

    <div data-event-filter-target="empty"
         class="hidden rounded bg-paper-100 text-paper-700 w-3/4 mx-auto p-6 mt-8 text-center">
      No events match this filter.
    </div>
  </section>
<% end %>

<%= turbo_stream.update "page_title" do %>
  <%= t("events.index.page_title", unit_name: current_unit.name) %>
<% end %>
