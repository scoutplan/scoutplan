<%= turbo_frame_tag :main do %>
  <header class="px-6 py-4 flex justify-between items-center border-b border-paper-300">
    <div>
      <p class="uppercase tracking-widest text-xs text-paper-700 font-medium mb-1">Schedule</p>
      <h1 class="md:text-3xl font-semibold font-serif">Upcoming</h1>
    </div>

    <nav class="flex items-center gap-2">
      <div class="bg-paper-200 border border-paper-300 rounded-lg p-0.5 flex">
        <%= link_to "Agenda", "#",
          class: "inline-block px-4 py-[5px] text-sm font-medium bg-white rounded text-paper-800"
        %>

        <%= link_to "Month", "#",
          class: "inline-block px-4 py-[5px] text-sm font-medium rounded text-paper-600"
        %>
      </div>

      <% if policy(Event).create? %>
        <%= link_to new_unit_event_path(@current_unit),
              class: "inline-block bg-brand-500 text-white rounded-lg px-4 py-2 text-sm font-medium" do %>
          <i class="fa-regular fa-plus"></i>
          New Event
        <% end %>
      <% end %>
    </nav>
  </header>


  <section id="event_months" class="">
    <%= render "blank_slate" %>

    <ol id="events_list">
      <% presenter = @presenter || EventPresenter.new %>
      <% @events_by_month.each do |month, events| %>
        <li class="event-month flex border-b border-paper-300"">
          <div class="month-header w-48 flex-shrink-0 px-6 py-5 text-sm">
            <h2 class="text-2xl text-paper-600 font-serif">
              <span class="text-paper-950"><%= month.strftime("%B") %></span>
              <%= month.strftime("%Y") %>
            </h2>

            <p><%= events.count %> events</p>
          </div>

          <ol class="w-full bg-white">
            <% events.each do |event| %>
              <% presenter.event = event %>

              <li class="px-6 py-5 event border-l-3 flex justify-between" style="border-left-color: <%= event.category.color %>">
                <%# left (date) section %>
                <div class="w-36 event-date-time text-xs font-semibold text-paper-600 uppercase flex flex-col gap-0">
                    <span class="tracking-wider"><%= event.starts_at.strftime("%b") %></span>
                    <span class="text-4xl text-paper-950 font-serif leading-tight">
                      <%= raw(event.dates_to_s) %>
                    </span>
                    <span class="tracking-wider">
                      <%= raw(presenter.days_to_s) %>
                    </span>
                </div>

                <%# middle section %>
                <div class="grow event-details px-4">
                  <p class="text-xs font-medium uppercase tracking-wider text-paper-600 mb-1">
                    <i class="fa-regular fa-fw fa-<%= event.category.glyph %>" style="color: <%= event.category.color %>"></i>
                    <%= event.category.name %>
                  </p>

                  <h3 class="font-serif font-bold text-lg mb-1"><%= event.title %></h3>
                  
                  <div class="flex gap-4">
                    <p class="text-xs text-paper-700">
                      <i class="fa-regular fa-clock fa-fw"></i>
                      <%= event.starts_at.strftime("%l:%M %p") %>
                      <% if event.ends_at.present? %>
                        &ndash; <%= event.ends_at.strftime("%l:%M %p") %>
                      <% end %>
                    </p>

                    <p><%= event.location %></p>
                  </div>
                </div>

                <div class="event-actions flex items-center gap-2">
                  <% if policy(event).edit? %>
                    <%= link_to edit_unit_event_path(@current_unit, event),
                          class: "p-2 text-sm text-paper-500 hover:text-brand-500",
                          data: { turbo_action: "advance", turbo_frame: "modal" } do %>
                      <i class="fa-solid fa-pen-to-square"></i>
                      Edit
                    <% end %>
                  <% end %>

                  <% if policy(event).destroy? %>
                    <%= link_to unit_event_path(@current_unit, event),
                          method: :delete,
                          data: { confirm: "Are you sure?", turbo_frame: "main" },
                          class: "p-2 text-sm text-paper-500 hover:text-red-500" do %>
                      <i class="fa-solid fa-trash"></i>
                      Delete
                    <% end %>
                  <% end %>
              </li>
            <% end %>
          </ol>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>

<%= turbo_stream.update "page_title" do %>
  <%= t("events.index.page_title", unit_name: current_unit.name) %>
<% end %>

<style>
  #events_list .more-past-events-item {
    display: none;
  }

  #events_list .more-past-events-item:first-of-type {
    display: block;
  }

  .event + .event {
    border-top: 1px solid #e2e8f0;
  }

  .event-tag-in-progress .event-tag-next, .event-tag-today .event-tag-next {
    display: none;
  }
</style>
