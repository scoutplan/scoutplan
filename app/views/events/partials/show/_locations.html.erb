<%# online is exclusive with places, so this section shows one or the other %>
<% return unless event.event_locations.present? || event.online? %>

<style>
  details[open] .disclosure-glyph {
    transform: rotate(180deg);
    transition: transform 0.2s ease-in-out;
  }

  #locations li:last-child .location-connector {
    display: none;
  }
</style>


<section id="locations" class="my-3">
  <% if event.online? %>
    <%= render partial: "events/partials/show/online_meeting" %>
  <% else %>
  <%# no heading: the map and pins are self-evident. a card that duplicated the
      first pin in the list below used to sit here too. %>
  <div class="hiddenz">
    <% if params[:map] == "static" %>
      <%= render partial: "events/partials/show/static_map" %>
    <% else %>
      <%= render partial: "events/partials/show/map" %>
    <% end %>

    <% if event.mappable? %>
      <p class="text-right">
        <%= link_to event_map_url(event),
                  target: "_new",
                  class: "text-xs text-stone-500 hover:text-stone-700 inline-block py-1",
                  aria: { role: "link" } do %>
          <i class="fa-regular fa-map text-stone-400"></i>
          &nbsp;&nbsp;
          <%= t("events.show.map") %>
        <% end %>
      </p>
    <% end %>


    <ol class="flex flex-col gap-5">
      <%# in_display_order derives from the enum, so a type can't be dropped by
          being left out of a hardcoded list %>
      <%= render partial: "events/partials/show/event_location",
              collection: event.event_locations.in_display_order %>
    </ol>
  </div>
  <% end %>
</section>