<% dashboard = EventDashboard.new(event) %>

<div class="rounded-lg mb-1 grid grid-cols-3 divide-x divide-stone-300 border border-paper-300 w-full md:w-sm">
  <div class="text-center p-2">
    <div class="text-xs font-semibold text-paper-600 tracking-wider"><%= number_to_percentage((dashboard.accept_rate) * 100, precision: 0) %></div>
    <div class="text-2xl text-green-600"><%= dashboard.acceptance_count %></div>
    <div class="text-xs uppercase font-semibold text-paper-600 tracking-wider">going</div>
  </div>

  <div class="text-center p-2">
    <div class="text-xs font-semibold text-paper-600 tracking-wider"><%= number_to_percentage((dashboard.decline_rate) * 100, precision: 0) %></div>
    <div class="text-2xl text-red-700"><%= dashboard.declines_count %></div>
    <div class="text-xs uppercase font-semibold text-paper-600 tracking-wider">declined</div>
  </div>

  <div class="text-center p-2">
    <div class="text-xs font-semibold text-paper-600 tracking-wider"><%= number_to_percentage((dashboard.non_response_rate) * 100, precision: 0) %></div>
    <div class="text-2xl"><%= dashboard.non_respondent_count %></div>
    <div class="text-xs uppercase font-semibold text-paper-600 tracking-wider">Pending</div>
  </div>
</div>

<%= link_to dashboard_unit_event_path(current_unit, event),
          class: "block text-right text-sm text-paper-700 hover:text-paper-800",
          title: "View & organize RSVPs",
          id: "organize_#{dom_id(event)}_link",
          data: { turbo_frame: "modal", turbo_action: "advance" } do %>
  Event Dashboard
  <i class="fa-regular fa-arrow-right"></i>
<% end %>
