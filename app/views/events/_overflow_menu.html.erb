<% ics_url = calendar_feed_unit_events_url(token: current_member.token,
                                          unit_id: current_unit.to_param,
                                          format: :ics,
                                          only_path: false,
                                          protocol: "webcal")
   https_url = calendar_feed_unit_events_url(token: current_member.token,
                                            unit_id: current_unit.to_param,
                                            format: :ics,
                                            only_path: false,
                                            protocol: "https")
%>

<div data-controller="dropdown" class="relative">
  <%= button_tag class: "h-[36px] w-[36px] flex items-center justify-center bg-paper-200 text-paper-600 border border-paper-300 rounded-lg",
        data: { action: "click->dropdown#toggle" } do %>
    <i class="fa-solid fa-ellipsis-vertical fa-fw"></i>
  <% end # button_tag %>

  <nav data-dropdown-target="menu"
       class="hidden z-30 block w-80 mt-1 px-6 py-4 text-sm text-stone-700 absolute right-0 rounded-lg dropdown-menu animate-pop-open \
        drop-shadow-overhead border border-stone-300 text-paper-700 bg-paper-50">
    <dl class="space-y-2">
      <dt class="text-xs text-paper-500 uppercase font-semibold tracking-widest">Subscribe</dt>
      
      <dd>
        <%= link_to ics_url,
                    class: "block -mx-4 px-4 py-2 rounded hover:bg-paper-100 rounded flex items-center gap-3",
                    data: { turbo: true, turbo_frame: "modal" } do %>
          <i class="fa-regular fa-rss text-paper-500 fa-lg"></i>
          <div class="text-xs text-paper-700">
              <div class="font-semibold text-paper-900 text-sm">Add to Apple Calendar</div>
              Live feed, auto-updates
          </div>
        <% end %>
      </dd>

      <dd>
        <%= link_to ics_url,
                    class: "block -mx-4 px-4 py-2 rounded hover:bg-paper-100 rounded flex items-center gap-3",
                    data: { turbo: true, turbo_frame: "modal" } do %>
          <i class="fa-regular fa-calendar text-paper-500 fa-lg"></i>
          <div class="text-xs text-paper-700">
              <div class="font-semibold text-paper-900 text-sm">Add to Google Calendar</div>
              Live feed, auto-updates
          </div>
        <% end %>
      </dd>

      <dd>
        <%= link_to ics_url,
                    class: "block -mx-4 px-4 py-2 rounded hover:bg-paper-100 rounded flex items-center gap-3",
                    data: { turbo: true, turbo_frame: "modal" } do %>
          <i class="fa-regular fa-link text-paper-500 fa-lg"></i>
          <div class="text-xs text-paper-700">
              <div class="font-semibold text-paper-900 text-sm">Copy Webcal URL</div>
              For other calendar apps
          </div>
        <% end %>
      </dd>      

      <hr class="border-paper-300 mb-4 -mx-4">

      <dt class="text-xs text-paper-500 uppercase font-medium tracking-widest">Export</dt>

      <dd>
        <%= link_to slow_list_unit_events_path(current_unit, format: :pdf),
              class: "block -mx-4 px-4 py-2 rounded hover:bg-paper-100 rounded flex items-center gap-3",
              data: { turbo_action: "advance" } do %>
          <i class="fa-regular fa-print text-paper-500 fa-lg"></i>
          <div class="text-xs text-paper-700">
              <div class="font-semibold text-paper-900 text-sm">Print upcoming events</div>
              Download a PDF
          </div>
        <% end %>
      </dd>

      <dd>
        <% if current_member.admin? %>
          <%= link_to slow_list_unit_events_path(current_unit, format: :pdf, season: "next"),
                      class: "block -mx-4 px-4 py-2 rounded hover:bg-paper-100 rounded flex items-center gap-3",
                      data: { turbo_action: "advance" } do %>
            <i class="fa-regular fa-calendar-arrow-down text-paper-500 fa-lg"></i>
            <div class="text-xs text-paper-700">
              <div class="font-semibold text-paper-900 text-sm">Print next season</div>
              Admins only
            </div>
          <% end %>
        <% end %>
      </dd>
    </dl>
  </nav>
</div>
