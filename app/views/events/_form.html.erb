<%= form_with model: event, scope: "event",
      url: event.new_record? ? unit_events_path(current_unit) : unit_event_path(current_unit, event),
      method: event.new_record? ? "post" : "patch",
      data: { turbo: false, controller: "event-edit event-attachments",
              event_edit_season_end_date_value: current_unit.this_season_ends_at.to_datetime.iso8601,
              event_edit_unit_id_value: current_unit.id,
              event_edit_event_id_value: event.id } do |f| %>

  <%= render partial: "organizers_popup", locals: { event: event } %>

  <%= render partial: "events/partials/form/top_nav", locals: { f: f, event: event } %>

  <div class="mx-auto max-w-6xl flex flex-col md:flex-row gap-8 w-full mt-4 px-8">
    <div class="grow">
      <section class="flex flex-col divide-y divide-stone-200 text-sm text-stone-600">
        <%# locations moved to the rail: see the Location group in the aside %>
        <% %w[basics dates rsvp description attachments].each do |section| %>
          <%= render partial: "events/partials/form/#{section}", locals: { f: f, event: event, section: section } %>
        <% end %>
      </section>
    </div>

    <aside class="w-1/4 text-sm text-stone-600">
      <div class="flex flex-col gap-1">
        <%# CATEGORY: the value carries its own meaning, so no label %>
        <div class="flex flex-row items-center gap-2 -mx-2 px-2 py-1 rounded hover:bg-brand-100">
          <%# a category without a colour still reads as "set": solid, but grey %>
          <i class="fa-fw shrink-0 <%= event.event_category ? "fa-solid fa-circle" : "fa-regular fa-circle-dashed" %> <%= "text-paper-500" if event.category&.color.blank? %>"
             style="<%= "color: #{event.category.color}" if event.category&.color.present? %>"
             data-event-edit-target="categoryGlyph"></i>

          <% category_options = event.unit.event_categories.order(:name).map { |c| [c.name, c.id, {"data-color" => c.color.to_s}] } %>

          <%# prompt, not include_blank: event_category is a required belongs_to,
              so the placeholder must disappear once one is chosen %>
          <%= f.select :event_category_id,
                options_for_select(category_options, event.event_category_id) +
                  options_for_select([["Add a category…", "_new"]]),
                { prompt: "No category" },
                { class: "grow border-0 p-0 bg-transparent text-sm focus:ring-0 cursor-pointer",
                  data: { event_edit_target: "categorySelect", action: "change->event-edit#updateCategory" },
                  required: "A category is required" } %>
        </div>

        <%# VISIBILITY %>
        <div class="flex flex-row items-center gap-2 -mx-2 px-2 py-1 rounded hover:bg-brand-100">
          <i class="fa-fw shrink-0 <%= event.published? ? "fa-solid fa-circle-check text-lime-600" : "fa-regular fa-pen-ruler text-paper-500" %>"></i>

          <% if event.cancelled? || event.archived? %>
            <span class="grow"><%= event.status.humanize %></span>
          <% else %>
            <%= f.select :status,
                  options_for_select([["Draft", "draft"], ["Published", "published"]], event.status),
                  {},
                  { class: "grow border-0 p-0 bg-transparent text-sm focus:ring-0 cursor-pointer" } %>
          <% end %>
        </div>

        <%# COVER PHOTO %>
        <div>
          <%= button_tag type: "button",
                class: "w-full flex flex-row items-center gap-2 -mx-2 px-2 py-1 rounded hover:bg-brand-100 cursor-pointer",
                onclick: "document.querySelector('#cover_photo_file_field').click();" do %>
            <i class="fa-regular fa-image fa-fw shrink-0 text-paper-500"></i>
            <span class="grow text-left">
              <%= event.cover_photo.attached? ? "Change cover photo" : "Add a cover photo" %>
            </span>
          <% end %>

          <div class="relative" data-event-edit-target="coverPhotoThumbnail">
            <% if event.cover_photo.attached? %>
              <%= image_tag event.cover_photo.representation(resize_to_fit: [200, 100]),
                    class: "mt-2 w-full h-24 object-cover object-center",
                    alt: event.title,
                    data: { event_edit_target: "coverPhotoThumbnailImage" } %>

              <div class="absolute right-0 bottom-0">
                <%= button_tag type: "button",
                      class: "block p-1 m-2 text-white border rounded text-xs hover:bg-white/30",
                      title: "Remove cover photo",
                      data: { action: "event-edit#removeCoverPhoto" } do %>
                  <i class="fa-light fa-trash-can fa-fw"></i>
                <% end %>
              </div>
            <% end %>

            <%= f.file_field :cover_photo, class: "hidden block w-full px-2 py-1 bg-stone-100 hover:bg-stone-200 text-sm focus:ring-0",
                  accept: "image/png, image/jpeg, image/jpg",
                  required: false,
                  id: "cover_photo_file_field",
                  data: { event_edit_target: "coverPhotoFile", action: "change->event-edit#coverPhotoSelected" } %>

            <%= hidden_field_tag :remove_cover_photo, "0", id: "remove_cover_photo_field", data: { event_edit_target: "removeCoverPhotoField" } %>
          </div>
        </div>

        <%# LOCATION %>
        <%= render partial: "events/partials/form/location_rail",
              locals: { f: f, event: event } %>

        <%# ORGANIZERS: keeps a label, since a bare list of names says little %>
        <div class="relative">
          <details id="organizers" data-event-edit-target="organizerListWrapper"
                   data-controller="dismissable"
                   data-dismissable-popup-id-value="organizers_popup">
            <summary class="flex flex-row justify-between items-center -mx-2 px-2 py-1 hover:bg-brand-100 rounded cursor-pointer active:-mx-[0.4rem]">
              <div class="text-paper-600">Organizers</div>
              <i class="fa-light fa-plus fa-fw"></i>
            </summary>
          </details>

          <div id="organizers_tag_field" class="flex flex-wrap gap-1 text-xs"
               data-controller="tag-field"
               data-tag-field-checkable-list-outlet="#organizers_popup">
            <% event.unit.unit_memberships.active.includes(:user).each do |member| %>
              <%= render partial: "organizer_tag", locals: { member: member, visible: event.organizer_members.include?(member) } %>
            <% end %>
          </div>
        </div>

        <%# TAGS %>
        <%= render partial: "tags/tag_section", locals: { taggable: event } %>

        <%# CANCEL: destructive, so it sits apart at the foot of the rail %>
        <% unless event.new_record? %>
          <div class="mt-6 pt-3 border-t border-paper-300">
            <%= link_to unit_event_cancel_path(current_unit, event),
                  id: "cancel_event_button",
                  class: "flex flex-row items-center gap-2 -mx-2 px-2 py-1 rounded \
                          text-brand-500 hover:text-brand-600 hover:bg-brand-100",
                  data: { turbo_frame: "modal_overlay", turbo_stream: true } do %>
              <i class="fa-regular fa-trash-can fa-fw shrink-0"></i>
              <span>Cancel this event</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </aside>
  </div>
<% end %>
