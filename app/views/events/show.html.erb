<%= render partial: "events/show/top_nav", locals: { event: @event } %>

<header class="flex flex-row justify-between px-6 py-3 text-stone-600">
  <div class="left">
    <i class="fa-light text-white fa-<%= @event&.category&.glyph %>" style="color: <%= @event&.category&.color %>"></i>
    &nbsp;
    <%= @event.category_name %>
  </div>

  <div class="right flex flex-row gap-2 text-stone-500 text-lg -mr-2">



  </div>
</header>

<% if @event.cover_photo.attached? %>
  <header class="relative">
    <%= image_tag @event.cover_photo.representation(resize_to_fit: [800, 800]), class: "w-full h-24 sm:h-36 md:h-48 object-cover object-center", alt: @event.title %>

    <div class="absolute left-0 right-0 bottom-0 h-1/2 bg-gradient-to-t from-stone-900 opacity-80"></div>

    <div class="absolute left-6 bottom-3 text-white text-2xl font-medium">
      <%= @event.title %>
    </div>
  </header>
<% end %>

<section class="overflow-y-auto">
  <section class="flex flex-col md:flex-row w-full overflow-auto block">
    <section class="event-maindata w-full md:w-2/3 grow px-6 py-3 overflow-auto block min-h-96">
      <%= render partial: "events/partials/show/header" %>

      <div class="flex flex-col divide-y divide-stone-200">
        <div class="pb-4">
          <%= render partial: "events/partials/show/date_single_day" if @event.single_day? %>
          <%= render partial: "events/partials/show/date_multi_day" if @event.multiday? %>
          <%= render partial: "events/partials/show/description" %>
        </div>

        <%= render partial: "events/partials/show/locations", locals: { event: @event } %>
        <%= render partial: "events/partials/show/weather" %>
        <%= render partial: "events/partials/show/attachments", locals: { event: @event } %>
      </div>
    </section>

    <aside class="event-metadata w-full md:w-1/3 pr-4 pb-4 flex flex-col gap-3 overflow-auto">
      <%= render partial: "events/partials/show/rsvp", locals: { event: @event } %>
      <%= render partial: "events/partials/show/costs" %>
      <%= render partial: "events/partials/show/organize", locals: { event: @event } %>
      <%= render partial: "events/partials/show/contact" %>
      <%= render partial: "events/partials/show/tags", locals: { event: @event } %>
    </aside>
  </section>
</section>

<style>
  .event-data:has(.event-metadata *) {
    max-width: 56rem;
  }
</style>


<%= turbo_stream.update "page_title" do %>
  <%= t("events.index.page_title", unit_name: current_unit.name) %>
<% end %>
