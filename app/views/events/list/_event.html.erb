<% cache event do %>
  <% presenter.event = event %>

  <li class="px-6 py-4 event border-l-3 flex flex-col md:flex-row gap-4 md:gap-0 justify-between hover:bg-stone-50 cursor-pointer"
      style="border-left-color: <%= event.category.color %>"
      data-controller="clickable-row"
      data-clickable-row-url-value="<%= unit_event_path(current_unit, event) %>"
      id="<%= dom_id(event) %>">

    <%# left (date) section %>
    <div class="w-36 shrink-0 event-date-time text-xs font-semibold text-paper-600 uppercase flex flex-col gap-0">
        <span class="tracking-wider"><%= event.starts_at.strftime("%b") %></span>
        <span class="text-3xl text-paper-950 font-serifz leading-tight"><%= raw(event.dates_to_s) %></span>
        <span class="tracking-wider"><%= raw(presenter.days_to_s) %></span>
    </div>

    <%# middle section %>
    <div class="grow event-details">
      <p class="text-xs font-medium uppercase tracking-wider text-paper-600 mb-1">
        <i class="fa-regular fa-fw fa-<%= event.category.glyph %>" style="color: <%= event.category.color %>"></i>
        <%= event.category.name %>

        <% if event.multiday? %>
          <span class="ml-2 px-1.5 py-0.5 text-xs font-medium bg-paper-200 text-paper-800 rounded-full">
            <i class="fa-regular fa-moon fa-fw"></i>
            <%= event.duration_in_days %> nights
          </span>
        <% end %>
      </p>

      <h3 class="font-serif font-bold text-lg mb-1"><%= event.title %></h3>
      
      <div class="flex gap-4">
        <p class="text-xs text-paper-700">
          <i class="fa-regular fa-clock fa-fw"></i>
          <%= event.starts_at.strftime("%l:%M %p") %>
          <% if event.ends_at.present? %>
            &ndash; <%= event.ends_at.strftime("%l:%M %p") %>
          <% end %>
        </p>

        <p><%= event.location %></p>
      </div>
    </div>

    <%# right section %>
    <% should_show_right_column = event.organizable? || event.requires_rsvp %>

    <% if should_show_right_column %>
      <% mode = event.organizable? &&
                  EventPolicy.new(current_member, event).rsvps? &&
                  params[:list_view] != "member" ? "admin" : "member" %>
      <%# mode = "member" %>
      <div>
        <% if mode == "admin" %>
          <%= render partial: "events/partials/event_row/organize", locals: { event: event } %>
        <% elsif event.requires_rsvp? && event.rsvp_closed? && !event.past? %>
          <div class="border border-dashed border-paper-500 rounded-lg p-4 flex gap-3 max-w-sm">
            <i class="fa-regular fa-clock fa-fw text-paper-500 mt-1"></i>
            <div class="text-sm">
              <h4 class="text-[15px]">RSVPs are closed</h4>
              <p class="text-paper-700">Your family didn't respond before <%= event.rsvp_closes_at.strftime("%b %d, %Y") %>.
                Contact the organizer if you'd still like to attend.</p>
            </div>
          </div>
        <% elsif event.requires_rsvp? %>
          <%= render partial: "events/partials/event_row/family_rsvp_link", locals: { event: event } %>
        <% end %>
      </div>
    <% end %>
  </li>
<% end # cache event %>