<%# when a cover photo is present it carries the <h1>, inverted to white over a
    scrim. The plain <h1> in events/show/_header is suppressed in that case, so
    the title is only ever rendered once. %>
<div class="relative">
  <%= image_tag event.cover_photo.representation(resize_to_fit: [800, 800]),
        class: "w-full h-24 sm:h-36 md:h-48 object-cover object-center",
        alt: event.title %>

  <div class="absolute left-0 right-0 bottom-0 h-1/2 bg-gradient-to-t from-stone-900 opacity-80"></div>

  <h1 class="absolute left-6 bottom-3 font-serif text-3xl font-medium text-white">
    <%= event.title %>
  </h1>
</div>
