<header class="py-3">
  <%= render Components::EventCategoryBadge.new(event: event) %>

  <%# with a cover photo the title is rendered inside it, above the date %>
  <% if event.cover_photo.attached? %>
    <div class="mt-3">
      <%= render partial: "events/show/cover_photo", locals: { event: event } %>
    </div>
  <% else %>
    <h1 class="font-serif text-3xl font-medium mt-3"><%= event.title %></h1>
  <% end %>

  <% if event.short_description.present? %>
    <p><%= event.short_description %></p>
  <% end %>

  <ol class="flex divide-x divide-paper-300 text-sm text-paper-700 gap-2 mt-4">
    <li class="uppercase text-sm tracking-wider pr-4">
      <span class="block"><%= event.starts_at.strftime("%b %Y") %></span>
      <span class="text-3xl text-paper-900 font-semibold"><%= event.dates_to_s %></span>
      <span class=""><%= event.days_to_s %></span>
    </li>

    <% if (times = event.times_to_s).present? %>
      <li class="uppercase text-sm tracking-wider pl-4 self-center">
        <%= times %>
      </li>
    <% end %>
  </ol>
</header>